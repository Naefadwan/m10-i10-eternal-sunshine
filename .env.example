# Template environment configuration. 
# Copy to .env and change the password placeholders before running `docker compose up`.

# Neo4j Database Credentials
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-before-running
NEO4J_AUTH=neo4j/change-me-before-running

# Frontend Web App Origin (for CORS configuration in API)
WEB_ORIGIN=http://localhost:3000
